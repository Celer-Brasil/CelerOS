# Guition ESP32-S3-4848S040 (N16R8): 16MB QIO + PSRAM 8MB OCTAL
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# 120MHz (experimental) nao compila no IDF 6.1.0 com flash QIO 80MHz:
# tabela MSPI_TIMING_FLASH_CONFIG_TABLE_CORE_CLK_240M_MODULE_CLK_80M_STR_MODE
# nao existe. Reavaliar em IDF 6.1.x futuro.
CONFIG_SPIRAM_SPEED_80M=y
# Boot: o memtest de PSRAM (default y) varre os 8 MB a cada boot e nao
# devolve nada em producao; o Tactility desliga (device.py:232).
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# GPIO19/20 desta placa NAO estao livres para o USB-OTG nativo (19 = SDA do
# touch GT911, 20 = linha G1 do display; o conector USB e apenas CH340). O
# console secundario JTAG-USB fica desligado para nao remuxar o GPIO19, e o
# celerctl roda sobre a UART do CH340 (SerialLink). O USB nativo (CDC dupla
# via TinyUSB) existe no codigo atras de CONFIG_CELEROS_USB_NATIVE para
# placas futuras com 19/20 livres.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Desempenho: 16MB de flash sobram (slot OTA ~6MB, binario ~1.7MB) — o
# interpretador JS (Duktape) e o desenho ganham com -O2. A CYD (4MB) segue
# em -Os pelo sdkconfig.defaults comum.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_SIZE is not set

# Celer Link (BLE entre CelerOS): NimBLE enxuto via C API do IDF —
# 1 conexao, os 4 papéis (central+peripheral p/ P2P), sem pareamento.
# O S3 nao tem BT classico; coexistencia WiFi/BLE e automatica.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
# CONFIG_BT_NIMBLE_NVS_PERSIST is not set
# Pools/buffers do HOST NimBLE na PSRAM: a RAM interna fica para o
# controller BLE + WiFi + DMA. Com tudo interno o boot sobrava ~60 KB, o init
# pedia mais e o os_mempool_init do ble_hs_init caia num
# SYSINIT_PANIC_ASSERT (o Celer Remote reiniciava o aparelho no 1o scan).
# Medido: o init passa a consumir ~38 KB internos (sobram ~22 KB)
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Ring de logs maior (tem PSRAM): historico do boot inteiro no logcat --dump
CONFIG_CELEROS_LOG_RING=8192
# RAM interna: mesma receita medida no watch e no cao (S3 com PSRAM).
# RX estatico e DMA interno: 8 buffers (16 x 1,6 KB antes) e janela BA igual;
# o TX estatico ja vai para a PSRAM (TRY_ALLOCATE_WIFI_LWIP).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=8
# Codigo do WiFi fora da IRAM: no S3 a IRAM sai da mesma DIRAM do heap
# interno (~20 KB de volta; vazao de pico um pouco menor).
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# .bss marcado com EXT_RAM_BSS_ATTR (HostLink, ring de logs, buffers da
# musica, slots da UI JS) vai para a PSRAM.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Cache de INSTRUCAO de 32 KB (16 KB padrao): o executor do Duktape e
# grande e, com 16 KB, trocava de linha o tempo todo buscando codigo na
# flash QIO (o mesmo MSPI da PSRAM do framebuffer). Medido 2026-10-09 no
# SmartDisplay: laco de grade -32%, for-in -77%; custa 16 KB de SRAM
# interna (sobra ~70 KB no pior caso). NAO mexer na linha do cache de
# DADOS: 64 B fez a UI inteira tremer (o Panel_RGB varre a PSRAM direto).
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# API 42: servicos de apps em segundo plano (svchost) LIGADOS; app em task
# propria (F3) DESLIGADO — o Kconfig torna as duas opcoes exclusivas. Com
# PSRAM o heap do svchost segue vivo enquanto um app esta em foreground.
CONFIG_CELEROS_APP_SERVICES=y
# CONFIG_CELEROS_APP_TASK is not set

# Sem microfone no hardware (o alto-falante NS4168 e I2S e segue no build
# pelo CELEROS_AUDIO): o canal de captura sai do binario e o objeto Mic
# nao nasce (typeof Mic === "undefined", como nas placas sem o periferico).
# CONFIG_CELEROS_MIC is not set
