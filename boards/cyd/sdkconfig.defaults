# Cheap Yellow Display (ESP32-2432S028R): ESP32 classico 4MB, sem PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4MB.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Slot OTA de 1,56MB (0x190000 = 1.638.400 B): logs ESP_LOGD/V ficam fora do
# binario (o VERBOSE do sdkconfig.defaults comum foi para depurar o touch I2C
# da SmartDisplay e custava dezenas de KB de strings aqui).
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
# CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE is not set
# Logs ESP_LOGI (IDF + componentes) tambem ficam fora: o logcat do CelerOS
# (celer_log_*) nao passa por ESP_LOG e segue completo. Desde o 1.7 o nivel
# e ERROR (era WARN): as strings ESP_LOGW dos componentes (wifi, lwip,
# mbedtls...) custavam ~19 KB e o slot OTA da 1.7 (bridge + TTS + QOA +
# logs persistentes) voltou a apertar — W sai, E fica. O logcat/kern.log
# do CelerOS (celer_log_*) nao passa por ESP_LOG e segue completo; as
# outras placas mantem WARN.
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
# CONFIG_LOG_DEFAULT_LEVEL_WARN is not set
# CONFIG_LOG_DEFAULT_LEVEL_INFO is not set

# Bundle de CAs "comum" (~45 raizes que cobrem a grande maioria dos sites:
# GitHub, Let's Encrypt, DigiCert...) em vez do completo: ~35 KB a menos no
# slot de 1,56MB. A SmartDisplay (16MB) segue com o bundle completo.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL is not set

# Slot microSD compartilhando o HSPI do TFT (CS=5): o mount anexa o cartao
# como segundo dispositivo do bus do display (multi-device do driver IDF —
# ver FileSystem.cpp/mountSD). FAT/SDSPI voltam ao binario (~30KB no slot
# de 1,56MB): em troca, apps/configs ganham giagas de cartao em vez dos
# 768KB do /local.
CONFIG_CELEROS_SD_CARD=y

# Heap para apps JS (32KB padrao roubam 12KB da RAM interna que o runtime
# Duktape precisa). Pico medido: ~8,5KB compilando o App Store (o compile
# do Duktape e recursivo); 20KB deixa folga para apps mais aninhados.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480

# RAM interna (sem PSRAM): o WiFi reservava 10 buffers RX estaticos (~16KB
# fixos) e o AMPDU RX segura mais. 4 estaticos + 16 dinamicos sobram para o
# trafego da CYD (loja, OTA, web server) — throughput menor, heap maior.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set

# Stacks do sistema pelo uso medido (celerctl ps, App Store rodando com
# HTTPS): sys_evt usa ~2KB dos 8KB do comum; esp_timer ~0,4KB de 3,5KB.
# O que sobra vira heap 8-bit — o handshake TLS de um app com rede precisa.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2560

# Unicore: habilita a IRAM livre (~40KB, so acesso 32-bit) como memoria
# acessivel a byte (emulacao por excecao, ~167 ciclos por acesso). Recebem
# essa regiao, fora do heap 8-bit: o buffer do fonte durante o compile de
# app JS (CelerKernel) e os buffers do TLS (mbedTLS). Sem isso os apps com
# rede de ~30KB (Settings, App Store) nao cabiam na RAM interna. O segundo
# core pouco rendia aqui (UI single-thread; WiFi divide o core 0).
CONFIG_ESP_SYSTEM_SINGLE_CORE_MODE=y
CONFIG_FREERTOS_UNICORE=y
CONFIG_ESP32_IRAM_AS_8BIT_ACCESSIBLE_MEMORY=y
CONFIG_MBEDTLS_IRAM_8BIT_MEM_ALLOC=y
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
# Buffers TLS FIXOS (16KB RX + 4KB TX): o modo IRAM so desvia alocacoes
# >= 4KB — com CONFIG_MBEDTLS_DYNAMIC_BUFFER os buffers viravam pedacos
# menores e caiam todos no heap 8-bit (handshake OOM medido).
# CONFIG_MBEDTLS_DYNAMIC_BUFFER is not set
# AES por software (tf-psa-crypto aes.c segue no link mesmo com o AES de
# hardware): so FT0/RT0 no flash, as outras 6 tabelas de 1 KB viram
# rotacoes em tempo de execucao. Medido 2026-10-20: -5,8 KB no slot.
CONFIG_MBEDTLS_AES_FEWER_TABLES=y

# IRAM livre = heap (unicore + IRAM acessivel a byte): codigo que so esta na
# IRAM por desempenho vai para a flash. O WiFi perde throughput de pico (a
# CYD baixa JSON e apps pequenos, nao video); a IRAM liberada vira espaco
# para o transbordo do heap JS, o fonte do compile e o TLS.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# IRAM livre = heap: das 12 opcoes do conjunto do Tactility (device.py:189-196),
# so TRES sao visiveis no IDF 6.1 sem SPI_FLASH_AUTO_SUSPEND. As outras 7
# (ESP_TIMER/SYSTEM/INTR/HW_SUPPORT_IN_IRAM, SPI_FLASH_PLACE_FUNCTIONS,
# LOG_IN_IRAM, LIBC_MISC_IN_IRAM) tem "bool ... if SPI_FLASH_AUTO_SUSPEND" e
# ficam forcadas no default: a linha em sdkconfig.defaults e no-op. Ligar
# auto-suspend muda o comportamento de escrita de flash (e o painel RGB
# depende dele) - nao nesta rodada.
# CONFIG_ESP_PHY_IRAM_OPT is not set
# CONFIG_WIFI_RMT_IRAM_OPT is not set
# CONFIG_WIFI_RMT_RX_IRAM_OPT is not set
# Ficam de fora: RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH (ISR em flash; medir
# com soak) e HEAP_PLACE_FUNCTION_INTO_FLASH (heap na flash dobra o compile
# do Duktape: 1,6s -> 3,1s).
# malloc/free ficam na IRAM: com o heap em flash o compile do Duktape
# (milhares de alocacoes) ficou 2x mais lento (Settings 1,6s -> 3,1s)

# Slot de 1,56MB: mensagens dos macros ESP_RETURN_ON_*/ESP_GOTO_ON_* do IDF
# (265 strings "%s(%d): ..." + o codigo das chamadas de log) saem; o erro
# segue sendo devolvido, so sem o texto. Junto: SAE-PK (WPA3 com chave
# publica, so hotspots raros; SAE comum segue), logs do coredump no boot
# (o dump na particao e o "celerctl coredump" seguem) e o print da versao
# do PHY. Medido 2026-10-09 na CYD: -33,6 KB (checks) e -10,5 KB (resto).
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
# CONFIG_ESP_WIFI_ENABLE_SAE_PK is not set
# CONFIG_ESP_COREDUMP_LOGS is not set
# CONFIG_ESP_PHY_ENABLE_VERSION_PRINT is not set

# API 42: servicos de apps em segundo plano (svchost) LIGADOS; app em task
# propria (F3) DESLIGADO — o Kconfig torna as duas opcoes exclusivas. Sem
# PSRAM o heap do svchost so nasce com >=44 KB livres (AppServices), entao
# ele espera o app de foreground sair em vez de competir com ele.
CONFIG_CELEROS_APP_SERVICES=y
# CONFIG_CELEROS_APP_TASK is not set

# ---- Perfil LITE da CYD (subset do OS no slot de 1,56MB) ----
# O hardware nao tem: I2S de audio (o alto-falante e ANALOGICO no GPIO26 —
# o System.playTone por LEDC segue, com beep assincrono de alarme/toast),
# microfone e PSRAM (mundo de fisica nativa nao vive no heap interno).
# O servidor web (file manager + /update pelo navegador) tambem sai:
# o captive portal do WiFi segue, e o celerctl por WiFi (DebugBridge)
# cobre push/pull/logcat/ota push; firmware vem pelo OTA do hub. Contratos
# JS preservados pelos stubs: playWav/playMusic devolvem false, sfx 0,
# musicPos -1, micLevel -1; Mic e System.verlet* ficam undefined (apps
# feature-detectam, como ja fazem com CelerLink/Camera).
# CONFIG_CELEROS_AUDIO is not set
# CONFIG_CELEROS_MIC is not set
# CONFIG_CELEROS_JS_PHYSICS is not set
# CONFIG_CELEROS_WEB_SERVER is not set
# IA fora: os apps de IA (Chat IA, Qwen) ja estao em data-exclude.txt — sem
# eles o objeto AI (transporte LLM/TTS em C++ + TLS) e ~10 KB de firmware que
# nenhum app alcanca. Desligado, typeof AI === "undefined" e a dep
# celeros.app.ai nao vem na imagem.
# CONFIG_CELEROS_JS_AI is not set
# Tela de crash com QR fica de fora no perfil lite: o codificador QR da
# LovyanGFX custa ~10 KB de flash e o slot OTA da CYD e o mais apertado das
# placas. O REGISTRO continua inteiro (RAM RTC + /local/log/crash.txt, que o
# agente de frota reporta); so a tela/QR nao entra.
# CONFIG_CELEROS_CRASH_SCREEN is not set
# Extras de UI (UI.custom com callback JS + UI.clip) ficam fora do perfil
# lite: ~1 KB de imagem que o slot OTA nao tem, e sem PSRAM o redesenho
# parcial nao paga. O kit JS cai no caminho base com a MESMA API
# (UI.extras=false; apps feature-detectam).
# CONFIG_CELEROS_UI_EXTRAS is not set
