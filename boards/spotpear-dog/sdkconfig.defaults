# Cao robotico SpotBear/ZZPET (ESP32-S3R8): 16MB DIO + PSRAM 8MB OCTAL embutida.
# Derivado do smartdisplay; diferencas: flash Boya DIO (nao QIO), console no
# USB-Serial/JTAG nativo (o unico conector USB da placa), sem SD.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Boot: memtest de PSRAM off (ver smartdisplay; device.py:232).
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
# Stack de task na PSRAM (worker do AI no JS): sem isso o xTaskCreateWithCaps
# nao poe stack la e o boot apertado do watch nao acha bloco de 24 KB interno
# (nome do IDF 6: o antigo SPIRAM_ALLOW_STACK_EXTERNAL nao existe mais)
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Console pelo USB-Serial/JTAG nativo (303a:1001): logs + OpenOCD. O
# SerialLink (celerctl) fala na MESMA porta USJ, multiplexado com o console
# como na UART: push/pull/dev/logcat/OTA pela unica USB da placa, sem abrir
# mao do console e do esptool ROM. Os pinos 19/20 pertencem a USJ —
# CELEROS_USB_NATIVE (OTG/CDC dupla) nao combina com esta board.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_CELEROS_LINK_ON_USJ=y

# Sem slot de cartao.
# CONFIG_CELEROS_SD_CARD is not set

# Desempenho: 16MB de flash sobram — interpretador JS e desenho com -O2.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_SIZE is not set

# Celer Link (BLE entre CelerOS): mesmo bloco NimBLE do smartdisplay.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
# CONFIG_BT_NIMBLE_NVS_PERSIST is not set

# Watchdog de bateria por ULP-RISC-V (deep sleep do System.deepSleep): o
# coprocessador le o divisor do ADC1 (GPIO2) a cada ~60 s e acorda os
# nucleos se a celula cair de ~3,3 V — o timer do JS segue valendo. O
# binario vive na RTC slow mem (4 KB de reserva la, nada sai da DRAM).
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_RISCV=y
CONFIG_ULP_COPROC_RESERVE_MEM=4096

# Ring de logs maior (tem PSRAM): historico do boot inteiro no logcat --dump
CONFIG_CELEROS_LOG_RING=8192

# Microfone MEMS INMP441 (I2S1 RX, pinos 4/5/6 do perfil): canal de captura
# + objeto Mic. O CELEROS_WAKE_WORD abaixo depende disto — sem esta linha ele
# era descartado em silencio pelo Kconfig e o cao perdeu mic E wake word
# (bancada 2026-10-19 media o build com MIC=y; a linha nunca chegou aqui).
CONFIG_CELEROS_MIC=y

# Wake word "Hi Celer" on-device (microWakeWord V2 treinado por nos,
# TFLite Micro): o app Dog Face ouve a palavra de ativacao e abre a janela
# de comando de voz (API 20).
CONFIG_CELEROS_WAKE_WORD=y

# Pools/buffers do HOST NimBLE na PSRAM (mesmo motivo do smartdisplay): com
# o host interno o Celer Link consumia 66 KB de RAM interna (71 -> 5 KB) e
# o DMA do I2S do microfone nao alocava mais — wake word surdo e GATT sem
# resposta (Celer Remote conectava e expirava no MTU/descoberta)
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# AES do TLS por SOFTWARE: o acelerador usa DMA, e dado na PSRAM (o corpo
# do comando de voz: ~150 KB de WAV em base64) passa por buffers de rebote
# na RAM INTERNA — com o wake word + BLE + amp a interna fica em ~13 KB e o
# envio morria no meio ("esp-aes: Failed to allocate memory", write error
# -0x84). AES em software no S3 custa pouca CPU e nao toca a interna.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# SHA idem: o driver PSA do IDF 6.1 aloca CADA contexto de hash em
# MALLOC_CAP_DMA|INTERNAL (psa_crypto_driver_esp_sha.c) — o handshake abre
# varios (transcript SHA-256/384). Com Link + wake word + mic a interna
# chegava a 600 B e o mbedtls_ssl_setup morria em -0x008D
# (PSA_ERROR_INSUFFICIENT_MEMORY) -> 0x7002 em TODO chat da voz (bancada
# 2026-10-05; o "coex BLE" era isso). Software: contexto no heap comum (PSRAM).
# CONFIG_MBEDTLS_HARDWARE_SHA is not set

# RAM interna do cao (mesma receita medida no watch): em repouso com Link +
# wake word + mic + alto-falante sobravam 2,8 KB (min 384 B) — qualquer
# handshake TLS ou rajada do WiFi morria por alocacao. Nenhum fluxo do cao
# precisa da vazao de pico: o maior e o upload de ~150 KB da voz e o TTS a
# 48 KB/s, e o lwIP ja limita a 4 segmentos em voo (TCP_SND_BUF/WND 5760).
# RX estatico e DMA interno: 8 buffers (16 x 1,6 KB antes) e janela BA igual.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=8
# Codigo do WiFi fora da IRAM: no S3 a IRAM sai da mesma DIRAM do heap
# interno (~20 KB de volta para o heap; vazao de pico um pouco menor).
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# Task de eventos do sistema: pico medido no watch < 1 KB de 8 KB.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# .bss marcado com EXT_RAM_BSS_ATTR (HostLink, ring de logs de 8 KB, buffers
# da musica, slots da UI JS) vai para a PSRAM, como no watch: ~14 KB internos.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# API 42: servicos de apps em segundo plano (svchost) LIGADOS; app em task
# propria (F3) DESLIGADO — o Kconfig torna as duas opcoes exclusivas. Com
# PSRAM o heap do svchost segue vivo enquanto um app esta em foreground.
CONFIG_CELEROS_APP_SERVICES=y
# CONFIG_CELEROS_APP_TASK is not set
