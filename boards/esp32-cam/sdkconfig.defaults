# ESP32-CAM AI-Thinker (modulo ESP32-S: ESP32 classico 4MB + 4MB PSRAM quad,
# OV2640, microSD, sem display). Base = perfil apertado do devkit/CYD (unicore
# + IRAM-as-heap, slot OTA e o limite), em cima dele: PSRAM, NimBLE (CelerNet)
# e a particao propria (apps no SD → littlefs enxuto, slots maiores).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4MB_cam.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Sem vidro de verdade: a pilha de video inteira sai do build (ver
# boards/devkit/sdkconfig.defaults — mesma decisao da rodada esp32-cam).
# CONFIG_CELEROS_UI is not set

# Camera OV2640 (API 35): puxa o esp32-camera 2.1.8 (managed, regra no
# main/idf_component.yml) + quirc vendado. Objeto Camera so para apps com
# a permission "camera".
CONFIG_CELEROS_JS_CAMERA=y

# Sem vidro, mas o logcat do celerctl segue completo (nao passa por ESP_LOG).
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
# CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE is not set
# ERROR, nao WARN: o driver da camera imprime "EV-EOF-OVF" com ets_printf de
# DENTRO da ISR quando o nivel padrao e >= WARN (CAM_WARN_THROTTLE). Com o
# console ocupado pelo outro nucleo a ISR esperava a UART e o watchdog de
# interrupcao derrubava a cam no video remoto (TG1WDT, bancada 2026-10-11).
# Os logs do CelerOS (celer_log_printf, [qr]) nao passam por este nivel.
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
# CONFIG_LOG_DEFAULT_LEVEL_WARN is not set
# CONFIG_LOG_DEFAULT_LEVEL_INFO is not set

# Bundle de CAs "comum" (~45 raizes): ~35 KB a menos no slot OTA.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL is not set

# PSRAM quad do modulo (40 MHz — o silicio rev1 do ESP32-S nao segura 80M):
# heap do runtime JS transborda pra ca, buffers TLS/lwIP e, na rodada da
# camera, os framebuffers JPEG. GPIO16/17 pertencem a ela.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# NimBLE (CelerNet + CelerLink + Pack): 4 papeis (malha = broadcaster/
# observer; link = peripheral/central), 1 conexao, pools do host na PSRAM.
# BTDM BLE_ONLY e exigencia do controlador do ESP32 classico. Custo medido
# ~250-300 KB de flash: cabe porque o perfil sem vidro devolveu mais que
# isso (CYD sem PSRAM nao consegue o mesmo truque de RAM).
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
# CONFIG_BT_NIMBLE_NVS_PERSIST is not set
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Ring de logs na PSRAM (historico do boot inteiro no logcat --dump).
CONFIG_CELEROS_LOG_RING=8192

# Heap para apps JS (piso do Duktape medido na CYD: 20KB deixa folga para
# apps aninhados; o compile recursivo chega a ~8,5KB de pico).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480

# RAM interna: WiFi com 4 buffers RX estaticos + 16 dinamicos e AMPDU off —
# throughput menor, heap maior (OTA, web server, malha).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set

# Stacks do sistema pelo uso medido (celerctl ps): sys_evt ~2KB, esp_timer
# ~0,4KB — o que sobra vira heap 8-bit para o runtime JS e o TLS.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2560

# Dual-core (NAO unicore): bancada 2026-10-10 — com unicore + IRAM-as-heap o
# boot da cam finalizava e o celerLoop caia em reset-loop (motivo 7 =
# INT_WDT; interruptos bloqueados: coexist WiFi x NimBLE no nucleo unico).
# A CYD aguenta unicore porque nao tem BT; a cam tem. Segundo nucleo tambem
# ajuda a captura (ISR da camera longe do Duktape).
CONFIG_ESP32_IRAM_AS_8BIT_ACCESSIBLE_MEMORY=y
CONFIG_MBEDTLS_IRAM_8BIT_MEM_ALLOC=y
# (o root defaults pede EXTERNAL=y das placas PSRAM S3; aqui o choice do
# mbedtls e o IRAM de 8 bits, como na CYD/devkit — explicito para o
# sdkconfig_check nao acusar a resolucao do choice como divergencia)
# CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC is not set
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
# Buffers TLS FIXOS (16KB RX + 4KB TX): o modo IRAM so desvia alocacoes >= 4KB.
# CONFIG_MBEDTLS_DYNAMIC_BUFFER is not set

# IRAM livre = heap: codigo que so esta na IRAM por desempenho vai para a
# flash (WiFi perde throughput de pico; a cam baixa JSON/OTA, nao video).
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

# Slot de 1,81MB: mensagens dos macros ESP_RETURN_ON_*/ESP_GOTO_ON_* do IDF
# saem; o erro segue sendo devolvido, so sem o texto (medido 2026-10-09).
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
# CONFIG_ESP_WIFI_ENABLE_SAE_PK is not set
# CONFIG_ESP_COREDUMP_LOGS is not set
# CONFIG_ESP_PHY_ENABLE_VERSION_PRINT is not set

# Dual-core (239b2c8): a task ipc0 roda as alocacoes de interrupcao do outro
# nucleo (driver da camera, WiFi/BT). Com o padrao de 1024 B o esp_camera_init
# chamado fora da task do app (provedor "camera" dos recursos da matilha)
# estourava a pilha dela: coredump "stack overflow in task ipc0" e RTC WDT em
# seguida (bancada 2026-10-11).
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048

# Driver da camera: buffer de DMA de no maximo 16 KB (eram 32 KB). Ele e um
# bloco CONTIGUO de RAM interna, e depois do WiFi + NimBLE o maior bloco
# livre da cam fica em ~10 KB: o init falhava em "DMA buffer 30720 Byte malloc
# failed" (bancada 2026-10-11). Com 8 KB o VGA nao cabe ("Resolution too
# high": o I2S do ESP32 amostra ate 4 B por pixel) — 16 KB e o meio-termo.
# A cam_task vai para o nucleo 1 (WiFi e o controlador BT ficam no 0, na
# mesma prioridade dela): no 0 a fila de eventos estourava (EV-VSYNC-OVF) e
# nenhum quadro saia.
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=16384
# CONFIG_CAMERA_CORE0 is not set
CONFIG_CAMERA_CORE1=y
