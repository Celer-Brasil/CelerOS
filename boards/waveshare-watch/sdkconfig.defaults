# Smartwatch Waveshare ESP32-S3-Touch-AMOLED-2.06 (ESP32-S3R8): 32MB DIO +
# PSRAM 8MB OCTAL embutida. Derivado do spotpear-dog (mesmo S3R8): console no
# USB-Serial/JTAG nativo, NimBLE para o Celer Link.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_32MB.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Boot: memtest de PSRAM off (ver smartdisplay; device.py:232).
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_USE_MALLOC=y
# malloc ate 1 KB fica na interna; acima vai para a PSRAM (quem precisa de
# DMA/interna pede por caps). Com 4096 os caches/buffers de 1-4 KB de
# TinyUSB, LittleFS e cia ficavam todos na interna: bancada 2026-10-08, com
# WiFi + Phone Link + malha, sobravam 7 K depois do BLE e um push/pull de
# 1 MB pelo USB levava a interna a 648 B; com 1024: 10 K e minimo 3,9 K.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# Stack de task na PSRAM (worker do AI no JS): sem isso o xTaskCreateWithCaps
# nao poe stack la e o boot apertado do watch nao acha bloco de 24 KB interno
# (nome do IDF 6: o antigo SPIRAM_ALLOW_STACK_EXTERNAL nao existe mais)
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# USB nativo (TinyUSB, GPIO19/20 livres no watch): CDC dupla — terminal
# humano + protocolo celerctl (HostLink). O celerctl ganha push/pull/tap/
# screencap/logcat direto no watch, sem UART fisica. O console sai da USJ
# (os pinos viram OTG) e vai para a UART0 sem conector: os logs vivem no
# shell CDC e no `celerctl logcat`. Flash segue pela mesma USB (ROM).
CONFIG_CELEROS_USB_NATIVE=y
# CDC0 shell + CDC1 celerctl (o default 1 faz o init do USB abortar cedo).
# ATENCAO: arquivo de defaults NAO aceita comentario inline na linha da opcao.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=2
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Desempenho: 32MB de flash sobram — interpretador JS e desenho com -O2.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_COMPILER_OPTIMIZATION_SIZE is not set

# Celer Link (BLE entre CelerOS): mesmo bloco NimBLE do smartdisplay/dog.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
# Phone Link (API 15): Gadgetbridge fala com o relogio como Bangle.js; o
# bond do celular (pareamento com codigo) persiste no NVS do NimBLE.
CONFIG_CELEROS_PHONE_LINK=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Energia (API 15, Hardware/PowerPolicy): DFS + light sleep automatico com a
# tela apagada. O BLE dorme junto (modem sleep com o XTAL principal ligado:
# o RTC do watch roda no RC interno, sem cristal de 32 kHz).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y

# WiFi cabendo na RAM interna: o watch gasta ~35 KB internos a mais que a
# SmartDisplay (TinyUSB dual CDC + tasks do HostLink + IMU) e o esp_wifi_init
# falhava com "esf_buf_setup_static: alloc eb fail" (16 RX + 16 TX estaticos
# = ~50 KB). Com TRY_ALLOCATE_WIFI_LWIP o TX estatico ja vai para a PSRAM;
# RX estatico precisa de DMA interno: 8 buffers e janela BA do mesmo tamanho.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=8

# .bss marcado com EXT_RAM_BSS_ATTR (quadros de 8 KB do HostLink) vai para a
# PSRAM: libera ~32 KB internos para o WiFi e o BLE do Phone Link.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Codigo do WiFi fora da IRAM: no S3 a IRAM sai da mesma DIRAM do heap
# interno (~20 KB a mais para WiFi + BLE juntos; vazao um pouco menor).
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# Task de eventos do sistema: pico medido < 1 KB de 8 KB.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Pools do host NimBLE (ACL/eventos/msys, ~11 KB) na PSRAM: com o celular
# conectado a RAM interna caia a ~6 KB com WiFi + BLE juntos.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Sentinela ULP-RISC-V (deep sleep): o coprocessador bit-banga o I2C0 nas
# RTC GPIO 14/15 e vigia a tecla PWR do AXP2101 (sem IRQ em GPIO, ela NAO
# acorda o deep sleep sem isto), o raise pela INT1 do IMU (filtro de
# janela) e a tensao da celula. O binario vive na RTC slow mem (4 KB de
# reserva la, nada sai da DRAM).
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_RISCV=y
CONFIG_ULP_COPROC_RESERVE_MEM=4096

# Ring de logs maior (tem PSRAM): historico do boot inteiro no logcat --dump
CONFIG_CELEROS_LOG_RING=8192

# API 42: servicos de apps em segundo plano (svchost) LIGADOS; app em task
# propria (F3) DESLIGADO — o Kconfig torna as duas opcoes exclusivas. Com
# PSRAM o heap do svchost segue vivo enquanto um app esta em foreground.
CONFIG_CELEROS_APP_SERVICES=y
# CONFIG_CELEROS_APP_TASK is not set
