# CelerOS — configuracao comum aos alvos (por-placa em boards/<board>/)
CONFIG_PARTITION_TABLE_CUSTOM=y

# Sem excecoes C++: nenhum codigo do build usa try/catch (nlohmann/JsonModels
# sairam do tree; sobras da lib esp_components arquivadas na tag
# archive/esp_components). Erro de alocacao/std:: vira abort, como ja era na
# pratica (nada capturava). Economiza .eh_frame + runtime de unwinding.
# CONFIG_COMPILER_CXX_EXCEPTIONS is not set

# A task main roda a UI + o interpretador Duktape (o heap JS e malloc, nao
# pilha). Pilha SEMPRE interna, entao cada KB sai do heap interno. Pico
# medido: ~7,2 KB no watch (-O2, launcher + mostrador) e ~8,5 KB na CYD
# (-Os, compilando o App Store). 24 KB = ~2,5x o pico; os 32 KB de antes
# eram o maior item da RAM interna das S3. CYD/devkit usam 20 KB.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# TLS valida certificados: HttpClient e o OTA anexam esp_crt_bundle_attach
# (bundle completo na SmartDisplay, CMN na CYD). INSECURE/SKIP_CERT_VERIFY
# ficaram no passado entre a v1.1 e a v1.3 — nao reative sem motivo muito bom.

CONFIG_FREERTOS_HZ=1000

# Handlers de evento (WifiConnection/NetworkManager) rodam na task sys_evt.
# Ja transbordou 4 KB com os handlers encadeados de uma versao antiga; hoje
# o pico medido (celerctl ps) e ~2,2 KB no watch e ~1,1 KB na CYD, e todas
# as placas rodavam 4 KB por override — virou o padrao comum.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# esp_timer: pico medido ~0,55 KB (watch) / ~0,4 KB (CYD) de 3,5 KB
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2560

# vTaskList (comando ps do shell celerctl/console) + CPU% por task (top).
# Clock = esp_timer (1 MHz, imune a DFS do watch, sem interrupcao nova) e
# contador U64 para nao dar wrap (~71 min no U32). Custo: incremento por
# context switch. Consumido por uxTaskGetSystemState no DeviceStats.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y

# Teto de log = nivel padrao: ESP_LOGD/V nao entram no binario nem custam
# o teste de nivel em runtime nos caminhos quentes dos drivers. Para depurar
# (ex.: ESP_LOGV do LovyanGFX no touch I2C) suba o teto so no build local.
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y

# OTA dev via HTTP puro na LAN (tools/ota_server.py) exige alem disso o
# opt-in /local/ota_allow_http.txt no aparelho (guard no OtaManager); HTTPS
# segue valendo sempre
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# Resiliencia (F2): task watchdog com panic — app JS travado em while(true)
# sem System.delay reinicia o aparelho em ~15s em vez de congelar para sempre
# (a main task e inscrita apos o setup; durante o boot os idles ja vigiam).
# OTA com rollback: slot novo so e confirmado apos 30s de boot sao; crash
# antes disso reverte para o slot anterior. Coredump vai para a particao
# dedicada (ler com celerctl coredump).
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
# O padrao do IDF (32 tasks) e o 64 que ficou no sdkconfig local estouravam
# a particao de 64 KB (dump pedia ~590 KB e gravava corrompido, sem forense).
# 16 tasks com stack limitada cabem.
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=16

# Release: tamanho (o padrao -Og estourava o slot OTA da CYD) e asserts
# sem strings de mensagem
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# Raizes alem da lista Mozilla (main/Assets/Tls/extra_roots.pem): a Cloudflare
# serve o openrouter.ai com GTS Root R4 CRUZADA pela GlobalSign Root CA de
# 1998, fora do bundle do IDF — sem ela o handshake das IA cai com UNKNOWN
# ERROR (bancada 2026-10-03).
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="main/Assets/Tls/extra_roots.pem"

# Tamanho: recursos de rede que o CelerOS nao usa. STA segue com WPA2/WPA3
# (SAE); o AP do captive portal e aberto ou WPA2. Nenhum codigo usa IPv6.
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_SOFTAP is not set
# CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT is not set
# CONFIG_LWIP_IPV6 is not set
# Tabela de nomes de esp_err_t (logs mostram o codigo numerico)
# CONFIG_ESP_ERR_TO_NAME_LOOKUP is not set

# Tamanho: o mbedTLS so faz o lado CLIENTE (HttpClient, OTA, IA; o web
# server local e HTTP puro e nao ha esp_https_server no tree). Sem
# renegociacao, sem escrita de PEM/parse de CSR, e curvas so as que a web
# usa: P-256/P-384 (raizes do bundle Mozilla) + X25519 (troca de chave).
# P-256 e CMAC seguem tambem pelo SMP do NimBLE e pelo PMF do WPA3.
# Medido 2026-10-09: -9,7 KB na CYD, -10 KB no watch.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# CONFIG_MBEDTLS_TLS_SERVER_AND_CLIENT is not set
# CONFIG_MBEDTLS_SSL_RENEGOTIATION is not set
# CONFIG_MBEDTLS_PEM_WRITE_C is not set
# CONFIG_MBEDTLS_X509_CSR_PARSE_C is not set
# CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED is not set

# ISR da UART em IRAM: durante erase/programa da flash (LittleFS em push/OTA) o
# ISR em cache congela, o FIFO RX (128 B) transborda em ~1,4 ms a 921600 e o
# stream de chunks do proto 2 perde bytes (framing destruido). O CDC/USJ tem
# NAK de protocolo e nao perde; a UART precisa do ISR residente.
CONFIG_UART_ISR_IN_IRAM=y

# Buffers do mbedtls (handshake TLS pede ~40KB internos) na PSRAM: com a RAM
# interna apertada o handshake falhava "UNKNOWN ERROR" e o xTaskCreate da task
# jsnet (32KB) nem nascia. Boards sem PSRAM nao ligam isto por padrao — o
# Kconfig do mbedtls so expoe a opcao com SPIRAM presente.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
